# Copy these into your shell environment (the backend reads real environment
# variables; it does not load .env files automatically). Placeholders only.

# Path of the SQLite database file (default: backend/foodbridge.db)
FOODBRIDGE_DB_PATH=./foodbridge.db

# Comma-separated list of browser origins allowed to call the API
FOODBRIDGE_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
